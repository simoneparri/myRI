# Copy to .env.external-db (ignored), chmod 600, and fill private credentials.
# Hostname must match the MySQL TLS certificate (VERIFY_IDENTITY).
# For MySQL on the Docker host: host.docker.internal, not localhost.
DB_HOST=
DB_PORT=3306
DB_NAME=myri
DB_USERNAME=myri_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=myri_migration
DB_MIGRATION_PASSWORD=
# No DB_ROOT_PASSWORD: database and accounts are provisioned by the external DBA.
APP_USERNAME=
APP_PASSWORD=
APP_TIMEZONE=Europe/Rome
COOKIE_SECURE=false
FRONTEND_PORT=8080
REMINDERS_ENABLED=true
CAREER_TALK_MONTHS=3
REMINDERS_INTERVAL_MS=60000
SPRING_PROFILES_ACTIVE=default
