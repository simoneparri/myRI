# Copy to .env (ignored). Fill all blank values with distinct, private passwords.
# No default credentials. APP_PASSWORD: at least 12 characters, at most 72 UTF-8 bytes.
# Names: lowercase ASCII letter, then lowercase letters/digits/underscore.
DB_NAME=myri
DB_USERNAME=myri_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=myri_migration
DB_MIGRATION_PASSWORD=
DB_ROOT_PASSWORD=
APP_USERNAME=
APP_PASSWORD=
APP_TIMEZONE=Europe/Rome
COOKIE_SECURE=false
FRONTEND_PORT=8080
# Use dev ONLY on a dedicated development database; it inserts fictitious data.
SPRING_PROFILES_ACTIVE=default
